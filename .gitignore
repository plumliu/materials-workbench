# Local configuration; commit only the empty example.
.env
.env.*
!.env.example

# Environments, caches and build products.
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
build/
dist/
node_modules/
.research/
/.tmp-wrought-live/

# Keep the workspace layout without committing manual data or results.
/pdfs/*
!/pdfs/.gitkeep
/figure_assets/*
!/figure_assets/.gitkeep
/runs/*
!/runs/.gitkeep
/library/*
!/library/.gitkeep

outputs/
*.sqlite
*.sqlite-*
